<odoo>
    <!-- Header shown instead of the company header when the document is a CFDI -->
    <template id="cfdi_report_header">
        <div t-attf-class="header o_company_#{company.id}_layout">
            <div class="o_clean_header">
                <div class="row px-3">
                    <div class="col-8 m-0 p-1">
                        <b class="text-uppercase " t-field="cfdi.type" />
                    </div>
                    <div class="col-4 text-end m-0 p-1">
                        <b>Folio:</b>
                        <span t-out="cfdi.name" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-3">
                        <img
                            t-if="cfdi.issuer_id.logo_url"
                            t-att-src="cfdi.issuer_id.logo_url"
                            class="img-fluid w-100"
                            style="max-height: 180px !important;"
                        />
                        <img
                            t-if="company.logo and not cfdi.issuer_id.logo_url"
                            class="img-fluid w-100"
                            t-att-src="image_data_uri(company.logo)"
                            style="max-height: 180px !important;"
                        />
                    </div>

                    <div class="row" style="font-size: 12px;">
                        <div class="m-0 p-1" style="width: 50%;">
                            <t t-call="l10n_mx_cfdi.cfdi_issuer_data" />
                        </div>

                        <div class="m-0 p-1" style="width: 50%;">
                            <t t-call="l10n_mx_cfdi.cfdi_receiver_data" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <template
        id="external_layout_standard"
        inherit_id="web.external_layout_standard"
        priority="99"
    >
        <!-- Replace the company header with the CFDI header in CFDI documents -->
        <xpath expr="//div[1]" position="attributes">
            <attribute name="t-if">not cfdi</attribute>
        </xpath>
        <xpath expr="//div[1]" position="before">
            <t t-call="l10n_mx_cfdi_account.cfdi_report_header" t-if="cfdi" />
        </xpath>

        <!-- Add CFDI note to footer -->
        <xpath expr="//div[contains(@t-attf-class, 'footer')]/div[1]" position="before">
            <div t-if="cfdi" class="col-12" style="font-size: 12px;">
                Este documento es una representación impresa de un CFDI
            </div>
        </xpath>
    </template>

